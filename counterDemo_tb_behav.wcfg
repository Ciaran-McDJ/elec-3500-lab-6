   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="145"></NameColumnWidth>
      <ValueColumnWidth column_width="85"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="8" />
   <wvobject type="logic" fp_name="/uart_tb/dut/rst">
