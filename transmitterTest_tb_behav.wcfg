<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="uart_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="uart_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="1,024.000000 us"></ZoomStartTime>
      <ZoomEndTime time="2,205.333334 us"></ZoomEndTime>
      <Cursor1Time time="1,035.515000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="162"></NameColumnWidth>
      <ValueColumnWidth column_width="94"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="12" />
   <wvobject type="logic" fp_name="/uart_tb/sys_clk">
      <obj_property name="ElementShortName">sys_clk</obj_property>
      <obj_property name="ObjectShortName">sys_clk</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/dut/tick_16x_en">
      <obj_property name="ElementShortName">tick_16x_en</obj_property>
      <obj_property name="ObjectShortName">tick_16x_en</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/dut/rst">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/transmit">
      <obj_property name="ElementShortName">transmit</obj_property>
      <obj_property name="ObjectShortName">transmit</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/uart_tb/tx_data">
      <obj_property name="ElementShortName">tx_data[7:0]</obj_property>
      <obj_property name="ObjectShortName">tx_data[7:0]</obj_property>
      <obj_property name="Radix">ASCIIRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/uart_tx_out">
      <obj_property name="ElementShortName">uart_tx_out</obj_property>
      <obj_property name="ObjectShortName">uart_tx_out</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/byte_sent">
      <obj_property name="ElementShortName">byte_sent</obj_property>
      <obj_property name="ObjectShortName">byte_sent</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/uart_tb/received_data">
      <obj_property name="ElementShortName">received_data[7:0]</obj_property>
      <obj_property name="ObjectShortName">received_data[7:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/uart_tb/dut/ourTransmitter/bit_state">
      <obj_property name="ElementShortName">bit_state[10:0]</obj_property>
      <obj_property name="ObjectShortName">bit_state[10:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/dut/ourTransmitter/S7_now">
      <obj_property name="ElementShortName">S7_now</obj_property>
      <obj_property name="ObjectShortName">S7_now</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/dut/ourTransmitter/transmitter_counter/S15_now">
      <obj_property name="ElementShortName">S15_now</obj_property>
      <obj_property name="ObjectShortName">S15_now</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/uart_tb/dut/ourTransmitter/transmitter_counter/counter_en">
      <obj_property name="ElementShortName">counter_en</obj_property>
      <obj_property name="ObjectShortName">counter_en</obj_property>
   </wvobject>
</wave_config>
